# Do not upload your brokerage credentials or licensed historical market data.
.env
*.env
*.key
*.pem
/data/
# Real-data RESULTS (metrics, returns, weights, forecasts, costs, equity) are derived and committed.
# Any file carrying raw market prices stays out: fills.csv holds reference/fill prices (and
# notional/shares recovers them). Regenerate it from the manifest hash + the pre-registered command.
/outputs/real_*/fills.csv
/outputs/etfs_*/
**/__pycache__/
**/.pytest_cache/
*.egg-info/
.venv/
# Licensed market data must never be committed: the Alpaca cache lives in data/, and any
# stray Parquet or interrupted-download file anywhere in impact/ is ignored too.
*.parquet
*.partial
